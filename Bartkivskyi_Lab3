using System;
using System.Text;

namespace Bartkivskyi_Lab3_ASD
{
    class Program
    {
        public static void Main(string[] args)
        {
            string text = "ababcaacab";
            string subText = "aba";
            Program.NaiveSearch(text, subText);
            Program.AlgorithmKMP(text, subText);
            Program.IndexOf(text, subText);
        }
        static int NaiveSearch(string text, string subText)
        {
            int n = text.Length;
            int m = subText.Length;

            for (int i = 0; i <= n - m; i++)
            {
                int j;
                for (j = 0; j < m; j++)
                {
                    if (text[i + j] != subText[j])
                    {
                        break;
                    }
                }
                if (j == m)
                {
                    return i;
                }
            }
            return -1;
        }
        static int AlgorithmKMP(string text, string subText)
        {
            int n = text.Length;
            int m = subText.Length;

            int[] lps = ComputeLPS(subText);

            int i = 0;
            int j = 0;

            while (i < n)
            {
                if (subText[i] == text[i])
                {
                    j++;
                    i++;
                }

                if (j == m)
                {
                    return i - j;
                }
                else if (i < n && subText[j] != text[i])
                {
                    if (j != 0)
                    {
                        j = lps[j - 1];
                    }
                    else
                    {
                        i++;
                    }
                }
            }
            return -1;
        }
        static int[] ComputeLPS(string subText)
        {
            int m = subText.Length;
            int[] lps = new int[m];

            int len = 0;
            int i = 1;

            lps[0] = 0;

            while (i < m)
            {
                if (subText[i] == subText[len])
                {
                    len++;
                    lps[i] = len;
                    i++;
                }
                else
                {
                    if (len != 0)
                    {
                        len = lps[len - 1];
                    }
                    else
                    {
                        lps[i] = 0;
                        i++;
                    }
                }
            }
            return lps;
        }
        public static int IndexOf(string text, string pattern)
        {
            if (string.IsNullOrEmpty(pattern)) return 0;
            if (string.IsNullOrEmpty(text)) return -1;

            char separator = '&';
            string S = pattern + separator + text;
            int m = pattern.Length;

            int[] pi = ComputePrefixFunction(S);

            for (int i = m + 1; i < S.Length; i++)
            {
                if (pi[i] == m)
                {
                    return i - 2 * m;
                }
            }
            return -1;
        }
        static int[] ComputePrefixFunction(string text)
        {
            int n = text.Length;
            int[] pi = new int[n];
            int j = 0;

            for (int i = 1; i < n; i++)
            {
                while (j > 0 && text[i] != text[j])
                {
                    j = pi[j - 1];
                }
                if (text[i] == text[j])
                {
                    j++;
                }
                pi[i] = j;
            }
            return pi;
        }
    }
}
